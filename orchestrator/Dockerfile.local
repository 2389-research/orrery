# ABOUTME: Docker build for the orchestrator in local/SQLite mode (full ML stack).
# ABOUTME: Uses uv for dependency management; includes torch, sentence-transformers, UMAP, FAISS.

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Use generic ARM64 target to avoid LLVM CPU-specific scheduling model bugs (numba#10388).
# Without this, LLVM detects Apple Silicon and picks an incomplete scheduling model → SIGILL.
# This enables full JIT (including UMAP transform + pynndescent) without SIGILL.
ENV NUMBA_CPU_NAME=generic

# Mirror repo layout so ../packages/orrery-relay resolves from pyproject.toml
COPY packages/orrery-relay/ /app/packages/orrery-relay/

WORKDIR /app/orchestrator

# Install dependencies from lockfile (deps only — project not yet copied)
# Torch resolves to CPU-only wheels via [tool.uv.index] in pyproject.toml
COPY orchestrator/pyproject.toml orchestrator/uv.lock ./
RUN uv sync --frozen --no-cache --no-install-project

# Copy application code + specs, then install the project itself
COPY orchestrator/src/ src/
COPY orchestrator/specs/ specs/

# The canonical galaxy viz, for GET /export/html. Copied rather than referenced so
# the export works in the image (which has no frontend checkout). pipeline/
# graph_export.viz_asset_dir() looks here first, then at a dev checkout.
COPY frontend/public/viz/ viz/
RUN uv sync --frozen --no-cache

EXPOSE 8000

# Run as a non-root user with the SAME uid (1000) the worker uses. Both services write
# the same /data, so a shared uid means a workspace this service creates is writable by
# the worker — otherwise a root-owned DB is unopenable by the worker and every job in it
# fails with "readonly database". The entrypoint chowns /data (as root) then drops to
# `worker`, mirroring worker/entrypoint.sh.
RUN useradd -m -u 1000 -s /bin/bash worker \
    && mkdir -p /data && chown -R worker:worker /app /data
COPY orchestrator/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
